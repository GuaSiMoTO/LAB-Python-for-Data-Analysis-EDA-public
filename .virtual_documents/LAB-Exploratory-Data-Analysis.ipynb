# Configuración de estilo
plt.figure(figsize=(14, 7))
sns.set_style("darkgrid")  # Fondo con grid oscuro


# Resample de ventas por mes y gráfico de línea
df.set_index('Date')['Sales']\
    .resample('M').sum()\
    .plot(color='#FF6B6B',  # Color coral
          linewidth=3,     # Grosor de línea
          marker='o',      # Marcadores en cada punto
          markersize=8,
          markerfacecolor='#4ECDC4',  # Color turquesa para marcadores
          markeredgewidth=2,
          markeredgecolor='black')

# Personalización
plt.title('Tendencia de Ventas Mensuales', fontsize=16, pad=20)
plt.xlabel('Fecha', fontsize=12)
plt.ylabel('Ventas Totales', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.7)  # Grid punteado


plt.tight_layout()
plt.show()






# Agrupar por mes, categoría y región
df['Month'] = df['Date'].dt.strftime('%b')
grouped = df.groupby(['Month', 'Category', 'Region'])['Sales'].sum().reset_index()

# Crear FacetGrid
g = sns.FacetGrid(grouped, col='Category', row='Region', height=5, aspect=1.2, margin_titles=True)
g.map_dataframe(sns.barplot, x='Month', y='Sales', color="violet")

# Ajustar etiquetas y diseño
g.set_axis_labels("Mes", "Ventas")
g.set_titles(row_template="{row_name}", col_template="{col_name}")
for ax in g.axes.flat:
    ax.tick_params(axis='x', rotation=45)

g.fig.subplots_adjust(top=0.9)
g.fig.suptitle("Ventas Mensuales por Categoría y Región", fontsize=16)

plt.tight_layout()
plt.show()







# Pair Plot simplificado
